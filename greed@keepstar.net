custom_proxy_group=🚀 节点选择`select`[]JP`[]JP CN2`[]JP IPLC`[]HK`[]HK CN2`[]HK IPLC`[]US`[]US CN2`[]DIRECT
custom_proxy_group=💬 Ai平台`select`[]JP`[]JP CN2`[]JP IPLC`[]HK`[]HK CN2`[]HK IPLC`[]US`[]US CN2`[]DIRECT
custom_proxy_group=🎮 游戏平台`select`[]JP`[]JP CN2`[]JP IPLC`[]HK`[]HK CN2`[]HK IPLC`[]US`[]US CN2`[]DIRECT
custom_proxy_group=🌍 国外媒体`select`[]JP`[]JP CN2`[]JP IPLC`[]HK`[]HK CN2`[]HK IPLC`[]US`[]US CN2`[]DIRECT
custom_proxy_group=📹 油管视频`select`[]JP`[]JP CN2`[]JP IPLC`[]HK`[]HK CN2`[]HK IPLC`[]US`[]US CN2`[]DIRECT
custom_proxy_group=📺 哔哩哔哩`select`[]DIRECT`[]JP`[]JP CN2`[]JP IPLC`[]HK`[]HK CN2`[]HK IPLC`[]US`[]US CN2
custom_proxy_group=🌏 国内媒体`select`[]DIRECT
custom_proxy_group=🎯 全球直连`select`[]DIRECT
custom_proxy_group=🛑 全球拦截`select`[]REJECT`[]DIRECT
custom_proxy_group=🐟 漏网之鱼`select`[]DIRECT`[]REJECT`[]JP`[]JP CN2`[]JP IPLC`[]HK`[]HK CN2`[]HK IPLC`[]US`[]US CN2
custom_proxy_group=HK`select`(HK)
custom_proxy_group=HK CN2`select`(HK)
custom_proxy_group=HK IPLC`select`(HK)
custom_proxy_group=JP`select`(JP)
custom_proxy_group=JP CN2`select`(JP)
custom_proxy_group=JP IPLC`select`(JP)
custom_proxy_group=US`select`(US)
custom_proxy_group=US CN2`select`(US)

enable_rule_generator=true
overwrite_original_rules=true
